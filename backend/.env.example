# === NAPAS APG ===
# Sandbox endpoints
NAPAS_BASE_URL=https://apg-stg.napas.com.vn
NAPAS_SIMULATOR_URL=https://apg-stg.napas.com.vn/bankdemo/app
NAPAS_CLIENT_TYPE=mock   # mock | real

# Security — PEM private key + cert NAPAS trả về
# Sinh key:  openssl genrsa -out client-privatekey.key 2048
# Sinh CSR:  openssl req -key client-privatekey.key -new -out client-apg-XX.csr
# Gửi CSR cho NAPAS → nhận cert → đặt đường dẫn cert ở đây
NAPAS_PRIVATE_KEY_PATH=
NAPAS_CERT_PATH=

# IP whitelist — NAPAS push notify từ IP này (comma-separated)
NAPAS_ALLOWED_IPS=103.9.4.46

# Credentials — chờ NAPAS cấp
# TODO[NAPAS-A2]: senderId / receiverId
NAPAS_SENDER_ID=
NAPAS_RECEIVER_ID=
# TODO[NAPAS-A3]: OAuth2 client credentials
NAPAS_CLIENT_ID=
NAPAS_CLIENT_SECRET=
NAPAS_TOKEN_URL=

# Legacy mock client (giữ tương thích)
NAPAS_API_URL=http://mock-napas.local
NAPAS_KEY_PATH=./keys/napas_mock.pem

# === Database ===
DB_URL=sqlite:///./1hub.db

# === CORS ===
CORS_ORIGINS=http://localhost:5173

# === Environment ===
ENV=dev

# === Auth / JWT ===
JWT_SECRET=change-me-in-production
API_KEY_MASTER_SECRET=change-me-api-key-secret
